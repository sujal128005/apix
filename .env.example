# APIx environment template.
#
# Committed WITHOUT values. Copy to `.env` and fill in for your machine:
#     cp .env.example .env
#
# `.env` is git-ignored and must never be committed.

# --- PostgreSQL 16 container (docker-compose.yml) ---------------------------
# Host port the container publishes on. Defaults to 5433 (not 5432) so APIx
# does not collide with another PostgreSQL already bound to the default port.
APIX_DB_PORT=
APIX_DB_HOST=
APIX_DB_NAME=

# Cluster superuser. Owns the schema and runs `CREATE ROLE` in migration 0003.
APIX_DB_SUPERUSER=
APIX_DB_SUPERUSER_PASSWORD=

# --- Application roles (created by migration 0003) --------------------------
# apix_migrator: full DDL. apix_app: DML only, with UPDATE/DELETE revoked on
# every append-only (IMM) table. Tests connect as apix_app.
APIX_MIGRATOR_USER=
APIX_MIGRATOR_PASSWORD=
APIX_APP_USER=
APIX_APP_PASSWORD=

# --- Tests ------------------------------------------------------------------
# Database created and dropped by the integration test session.
APIX_TEST_DB_NAME=

# --- Compliance (Phase 4A) --------------------------------------------------
# Contact URL embedded in the crawler's User-Agent so any site operator can
# reach us. REQUIRED: with this unset the gate refuses every fetch. APIx does
# not crawl anonymously.
APIX_CONTACT_URL=

# Overrides below are permitted in one direction only - toward greater
# restraint. The crawl delay may be raised above 5.0s but never lowered; the
# daily budget may be lowered below 200 but never raised. Violations raise at
# load time. See packages/compliance/config.py.
APIX_DEFAULT_CRAWL_DELAY=
APIX_DAILY_REQUEST_BUDGET=
APIX_TOKEN_TTL_SECONDS=
APIX_ROBOTS_CACHE_TTL_HOURS=
APIX_ROBOTS_STALE_MAX_DAYS=
APIX_ROBOTS_FETCH_TIMEOUT=
